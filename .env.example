# Database Configuration
DB_USER=postgres
DB_PASSWORD=your_secure_password
DB_NAME=pms_db
DB_HOST=localhost
DB_PORT=5432

# Server Configuration
PORT=5000
NODE_ENV=production

# CORS Configuration
# List of allowed origins (comma-separated)
# Example: https://yourdomain.com,https://app.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3000

# JWT Configuration (if using JWT)
JWT_SECRET=your_very_secure_secret_key_here

# Notes:
# 1. For production:
#    - Set NODE_ENV=production (enables secure cookies over HTTPS only)
#    - Use strong passwords and secrets
#    - Change ALLOWED_ORIGINS to your actual frontend domain(s)
#    - Use HTTPS certificates (already configured in config/https.js)
#
# 2. Cookie Security:
#    - httpOnly: true (prevents JS access, blocks XSS attacks)
#    - secure: true (only sent over HTTPS in production)
#    - sameSite: 'Lax' (prevents CSRF attacks)
#    - maxAge: 24h (1 day expiration)
#
# 3. CORS with credentials:
#    - When credentials: true, origin cannot be '*'
#    - Must explicitly list allowed origins
#    - Client must send credentials: 'include' in fetch/axios
